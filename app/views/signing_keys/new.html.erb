<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <div style="background: white; border-radius: 12px; padding: 40px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); max-width: 400px; width: 100%; margin: 20px;">
    <h2 style="margin: 0 0 8px 0; font-size: 22px; text-align: center; color: #1a1a1a;">Enter Signing Key</h2>
    <p style="margin: 0 0 24px 0; font-size: 14px; text-align: center; color: #666;">Enter or paste the 6-digit key from your email</p>

    <% if @error.present? %>
      <div style="background: #fee2e2; border: 1px solid #fca5a5; border-radius: 8px; padding: 12px; margin-bottom: 16px; text-align: center; color: #dc2626; font-size: 14px;">
        <%= @error %>
      </div>
    <% end %>

    <form id="signing-key-form" onsubmit="return false;">
      <div style="display: flex; gap: 8px; justify-content: center; margin-bottom: 24px;">
        <% 6.times do |i| %>
          <input
            type="text"
            maxlength="1"
            inputmode="numeric"
            pattern="[0-9]"
            class="key-digit"
            data-index="<%= i %>"
            autocomplete="off"
            style="width: 48px; height: 56px; text-align: center; font-size: 24px; font-weight: 600; border: 2px solid #d1d5db; border-radius: 8px; outline: none; transition: border-color 0.2s;"
            onfocus="this.style.borderColor='#3b82f6'"
            onblur="this.style.borderColor='#d1d5db'"
            <%= 'autofocus' if i == 0 %>
          >
        <% end %>
      </div>
      <input type="hidden" id="signing-key-hidden" value="">
      <button type="button" id="submit-btn" style="width: 100%; padding: 12px; background: #3b82f6; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'">
        Open Document
      </button>
    </form>

    <p style="margin: 16px 0 0 0; font-size: 12px; text-align: center; color: #999;">You can also paste all 6 digits at once</p>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var digits = document.querySelectorAll('.key-digit');
  var hidden = document.getElementById('signing-key-hidden');
  var submitBtn = document.getElementById('submit-btn');

  function updateHidden() {
    var val = '';
    digits.forEach(function(d) { val += d.value; });
    hidden.value = val;
  }

  function navigateToKey() {
    var key = hidden.value;
    if (key.length === 6) {
      window.location.href = '/sign/' + key;
    }
  }

  submitBtn.addEventListener('click', navigateToKey);

  digits.forEach(function(input, idx) {
    input.addEventListener('input', function(e) {
      var v = this.value.replace(/[^0-9]/g, '');
      this.value = v.slice(0, 1);
      if (v.length > 0 && idx < 5) digits[idx + 1].focus();
      updateHidden();
      if (hidden.value.length === 6) navigateToKey();
    });

    input.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && !this.value && idx > 0) {
        digits[idx - 1].focus();
        digits[idx - 1].value = '';
        updateHidden();
      }
    });

    input.addEventListener('paste', function(e) {
      e.preventDefault();
      var text = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '').slice(0, 6);
      for (var i = 0; i < text.length && i < 6; i++) {
        digits[i].value = text[i];
      }
      if (text.length > 0) digits[Math.min(text.length, 5)].focus();
      updateHidden();
      if (hidden.value.length === 6) navigateToKey();
    });
  });
});
</script>
