<style>
  @font-face { font-family: 'IBM Plex Sans'; font-weight: 400; font-display: swap; src: url('/fonts/ibm-plex-sans-latin-400-normal.woff2') format('woff2'); }
  @font-face { font-family: 'IBM Plex Sans'; font-weight: 600; font-display: swap; src: url('/fonts/ibm-plex-sans-latin-600-normal.woff2') format('woff2'); }
  @font-face { font-family: 'IBM Plex Sans'; font-weight: 700; font-display: swap; src: url('/fonts/ibm-plex-sans-latin-700-normal.woff2') format('woff2'); }
  html, body { margin: 0; background: #502E91; }
  .wk-page { min-height: 100vh; box-sizing: border-box; padding: 12px; display: flex; flex-direction: column; gap: 12px; font-family: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #333333; }
  .wk-brand { background: #ffffff; border-radius: 20px; padding: 12px 20px; display: flex; align-items: center; }
  .wk-card { flex: 1; background: #ffffff; border-radius: 20px; display: flex; align-items: center; justify-content: center; padding: 32px 20px; box-shadow: 0 8px 24px rgba(20, 8, 50, 0.18); }
  .wk-inner { width: 100%; max-width: 420px; text-align: center; }
  .wk-inner h2 { margin: 0 0 8px; font-size: 26px; font-weight: 600; color: #333333; }
  .wk-inner p.wk-lead { margin: 0 0 28px; font-size: 15px; color: #666666; }
  .wk-digits { display: flex; gap: 8px; justify-content: center; margin-bottom: 24px; }
  .key-digit { width: 48px; height: 58px; text-align: center; font-size: 24px; font-weight: 600; font-family: inherit; color: #333333; border: 2px solid #e6e1ef; border-radius: 14px; outline: none; transition: border-color 0.2s; }
  .key-digit:focus { border-color: #CB007B; }
  #submit-btn { width: 100%; padding: 14px; background: #CB007B; color: #ffffff; border: none; border-radius: 40px; font-family: inherit; font-size: 16px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; transition: background 0.2s; }
  #submit-btn:hover { background: #A80066; }
  .wk-hint { margin: 16px 0 0; font-size: 13px; color: #929293; }
  .wk-error { background: #fdecf4; border: 1px solid #f2b6d4; border-radius: 14px; padding: 12px; margin-bottom: 16px; color: #A80066; font-size: 14px; }
  .wk-foot { text-align: center; color: rgba(255, 255, 255, 0.85); font-size: 12px; letter-spacing: 0.02em; }
  @media (min-width: 720px) { .wk-page { padding: 20px; gap: 20px; } .wk-brand { justify-content: center; padding: 14px 28px; } }
</style>
<div class="wk-page">
  <div class="wk-brand"><%= render 'shared/logo', height: '28' %></div>
  <div class="wk-card">
    <div class="wk-inner">
      <h2>Enter Signing Key</h2>
      <p class="wk-lead">Enter or paste the 6-digit key from your email</p>

      <% if @error.present? %>
        <div class="wk-error"><%= @error %></div>
      <% end %>

      <form id="signing-key-form" onsubmit="return false;">
        <div class="wk-digits">
          <% 6.times do |i| %>
            <input
              type="text"
              maxlength="1"
              inputmode="numeric"
              pattern="[0-9]"
              class="key-digit"
              data-index="<%= i %>"
              autocomplete="off"
              <%= 'autofocus' if i == 0 %>
            >
          <% end %>
        </div>
        <input type="hidden" id="signing-key-hidden" value="">
        <button type="button" id="submit-btn">Open Document</button>
      </form>

      <p class="wk-hint">You can also paste all 6 digits at once</p>
    </div>
  </div>
  <div class="wk-foot">Via Wippli&reg; Sign. Powered by DocuSeal under AGPL-3.0 licence.</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var digits = document.querySelectorAll('.key-digit');
  var hidden = document.getElementById('signing-key-hidden');
  var submitBtn = document.getElementById('submit-btn');

  function updateHidden() {
    var val = '';
    digits.forEach(function(d) { val += d.value; });
    hidden.value = val;
  }

  function navigateToKey() {
    var key = hidden.value;
    if (key.length === 6) {
      window.location.href = '/sign/' + key;
    }
  }

  submitBtn.addEventListener('click', navigateToKey);

  digits.forEach(function(input, idx) {
    input.addEventListener('input', function(e) {
      var v = this.value.replace(/[^0-9]/g, '');
      this.value = v.slice(0, 1);
      if (v.length > 0 && idx < 5) digits[idx + 1].focus();
      updateHidden();
      if (hidden.value.length === 6) navigateToKey();
    });

    input.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && !this.value && idx > 0) {
        digits[idx - 1].focus();
        digits[idx - 1].value = '';
        updateHidden();
      }
    });

    input.addEventListener('paste', function(e) {
      e.preventDefault();
      var text = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '').slice(0, 6);
      for (var i = 0; i < text.length && i < 6; i++) {
        digits[i].value = text[i];
      }
      if (text.length > 0) digits[Math.min(text.length, 5)].focus();
      updateHidden();
      if (hidden.value.length === 6) navigateToKey();
    });
  });
});
</script>
