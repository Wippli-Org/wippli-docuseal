<p>Hi <%= @recipient.name.presence || 'there' %>,</p>
<% if @send_only %>
  <%# Wippli: Send Only - the recipient entered the key sent to their address and opened the document. That is the proof of delivery. %>
  <p><strong><%= @submitter.name.presence || @submitter.email %></strong> (<%= @submitter.email %>) opened <strong><%= @submission.name || @submission.template.name %></strong> on <%= (@submitter.opened_at || Time.current).strftime('%d %b %Y %H:%M %Z') %> using the access key sent to that address.</p>
  <p>Delivery confirmed. Nothing further is required from either party.</p>
<% else %>
  <p><strong><%= @submitter.name.presence || @submitter.email %></strong> has viewed <strong><%= @submission.name || @submission.template.name %></strong>.</p>
  <p>You will receive another notification once they have signed.</p>
<% end %>
<%# Wippli: the DocuSeal submission page enforces authenticate_user!, so a recipient
    without a Wippli Sign account lands on "You need to sign in or sign up before
    continuing." Link to the Wippli task board instead - it is reached with the
    signing key, which every party already has. No board, no link. %>
<% board_url = @submitter.metadata['wippli_guest_url'].presence %>
<% if board_url %>
  <p><%= link_to 'Open the task in Wippli', board_url %></p>
<% end %>
