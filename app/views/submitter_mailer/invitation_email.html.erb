<%
  # Wippli: Construct signing URL using Wippli guest URL if available
  wippli_guest_url = @submitter.metadata['wippli_guest_url']
  tracking_param = SubmissionEvents.build_tracking_param(@submitter, 'click_email')

  if wippli_guest_url.present?
    # Use Wippli guest URL with DocuSeal slug appended
    sign_url = "#{wippli_guest_url}?slug=#{@submitter.slug}&t=#{tracking_param}"
    fallback_sign_url = "#{wippli_guest_url}?slug=#{@submitter.slug}&t=#{tracking_param}"
  else
    # Fall back to default DocuSeal URL
    sign_url = submit_form_url(slug: @submitter.slug, t: tracking_param, host: ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host]))
    fallback_sign_url = submit_form_url(slug: @submitter.slug, t: tracking_param)
  end
%>
<% if @body.present? %>
  <%= render 'custom_content', content: @body, submitter: @submitter %>
  <% if !@body.match?(ReplaceEmailVariables::SUBMITTER_LINK) && !@body.match?(ReplaceEmailVariables::SUBMITTER_ID) && !@body.match?(ReplaceEmailVariables::SUBMISSION_LINK) && !@body.match?(ReplaceEmailVariables::TEMPLATE_ID) && !@submitter.submission.source.in?(%w[api embed]) %>
    <p><%= link_to nil, fallback_sign_url %></p>
  <% end %>
<% else %>
  <p><%= t('hi_there') %>,</p>
  <p><%= I18n.t(@submitter.with_signature_fields? ? :you_have_been_invited_to_sign_the_name : :you_have_been_invited_to_submit_the_name_form, name: @submitter.submission.name || @submitter.submission.template.name) %></p>
  <p><%= link_to I18n.t(@submitter.with_signature_fields? ? :review_and_sign : :review_and_submit), sign_url %></p>
  <p><%= t('please_contact_us_by_replying_to_this_email_if_you_have_any_questions') %></p>
  <p>
  <%= t('thanks') %>,<br><%= @current_account.name %>
  </p>
<% end %>
