<%
  # Wippli: Construct signing URL using Wippli guest URL if available
  wippli_guest_url = @submitter.metadata['wippli_guest_url']
  signing_key = @submitter.metadata['signing_key']
  tracking_param = SubmissionEvents.build_tracking_param(@submitter, 'click_email')

  if wippli_guest_url.present?
    # Build full DocuSeal signing URL and pass as embed parameter
    docuseal_host = ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host])
    docuseal_sign_url = submit_form_url(slug: @submitter.slug, t: tracking_param, host: docuseal_host)
    separator = wippli_guest_url.include?('?') ? '&' : '?'
    sign_url = "#{wippli_guest_url}#{separator}embed=#{CGI.escape(docuseal_sign_url)}"
    fallback_sign_url = sign_url
  else
    # Fall back to default DocuSeal URL
    sign_url = submit_form_url(slug: @submitter.slug, t: tracking_param, host: ENV.fetch('EMAIL_HOST', Docuseal.default_url_options[:host]))
    fallback_sign_url = submit_form_url(slug: @submitter.slug, t: tracking_param)
  end
%>
<%# Wippli: personal message from the sender (form "Message" field, carried in submitter metadata).
    Rendered as a note ABOVE the standard email so the default Sign button is always kept. %>
<% wippli_message = @submitter.metadata['wippli_message'].to_s.strip %>
<%# In the Send Only recipient email the message sits AFTER the opening line (rendered further down). %>
<% send_only_recipient = @submitter.metadata['wippli_delivery'] == 'send_only' && !@send_only_sender %>
<% if wippli_message.present? && !send_only_recipient %>
  <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 20px;">
    <tr><td style="border-left: 3px solid #d1d5db; padding: 6px 14px;">
      <p style="margin: 0 0 6px; font-weight: 600;">Message:</p>
      <p style="margin: 0; white-space: pre-line;"><%= wippli_message %></p>
    </td></tr>
  </table>
<% end %>
<% if @submitter.metadata['wippli_delivery'] == 'send_only' && @send_only_sender %>
  <%# Wippli: Send Only - SENDER copy: the key opens the board to review and send. %>
  <% recipient = @submitter.submission.submitters.reject { |s| s.id == @submitter.id }.first %>
  <p>Hi <%= @submitter.name.presence || 'there' %>,</p>
  <p>The document "<%= @submitter.submission.name || @submitter.submission.template.name %>" is ready to send<% if recipient %> to <%= recipient.name.presence || recipient.email %> &lt;<%= recipient.email %>&gt;<% end %>.</p>
  <p><%= link_to 'Review and send', sign_url %></p>
  <% if signing_key.present? %>
    <p style="margin: 16px 0;">Your access key: <strong style="font-size: 20px; letter-spacing: 4px; background: #f3f4f6; padding: 8px 16px; border-radius: 6px; font-family: monospace;"><%= signing_key %></strong></p>
    <p style="font-size: 13px; color: #666;">Enter this key on the task to review the document and press Send. Nothing is sent until you do.</p>
  <% end %>
  <p>
  <%= t('thanks') %>,<br><%= @current_account.name %>
  </p>
<% elsif @submitter.metadata['wippli_delivery'] == 'send_only' %>
  <%# Wippli: Send Only - RECIPIENT copy: the document was sent to them; no signing, no acceptance. %>
  <p>Hi <%= @submitter.name.presence || 'there' %>,</p>
  <p>You have been sent the document "<%= @submitter.submission.name || @submitter.submission.template.name %>" by <%= @current_account.name %>.</p>
  <% if wippli_message.present? %>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin: 16px 0 20px;">
      <tr><td style="border-left: 3px solid #d1d5db; padding: 6px 14px;">
        <p style="margin: 0 0 6px; font-weight: 600;">Message:</p>
        <p style="margin: 0; white-space: pre-line;"><%= wippli_message %></p>
      </td></tr>
    </table>
  <% end %>
  <p><%= link_to 'Open document', sign_url %></p>
  <% if signing_key.present? %>
    <p style="margin: 16px 0;">Your access key: <strong style="font-size: 20px; letter-spacing: 4px; background: #f3f4f6; padding: 8px 16px; border-radius: 6px; font-family: monospace;"><%= signing_key %></strong></p>
    <p style="font-size: 13px; color: #666;">Enter this key on the page to open the document.</p>
  <% end %>
  <p><%= t('please_contact_us_by_replying_to_this_email_if_you_have_any_questions') %></p>
  <p>
  <%= t('thanks') %>,<br><%= @current_account.name %>
  </p>
<% elsif @body.present? %>
  <%= render 'custom_content', content: @body, submitter: @submitter %>
  <% if !@body.match?(ReplaceEmailVariables::SUBMITTER_LINK) && !@body.match?(ReplaceEmailVariables::SUBMITTER_ID) && !@body.match?(ReplaceEmailVariables::SUBMISSION_LINK) && !@body.match?(ReplaceEmailVariables::TEMPLATE_ID) && !@submitter.submission.source.in?(%w[api embed]) %>
    <p><%= link_to nil, fallback_sign_url %></p>
  <% end %>
<% else %>
  <p>Hi <%= @submitter.name.presence || 'there' %>,</p>
  <p><%= I18n.t(@submitter.with_signature_fields? ? :you_have_been_invited_to_sign_the_name : :you_have_been_invited_to_submit_the_name_form, name: @submitter.submission.name || @submitter.submission.template.name) %></p>
  <p><%= link_to I18n.t(@submitter.with_signature_fields? ? :review_and_sign : :review_and_submit), sign_url %></p>
  <% if signing_key.present? %>
    <p style="margin: 16px 0;">Your signing key: <strong style="font-size: 20px; letter-spacing: 4px; background: #f3f4f6; padding: 8px 16px; border-radius: 6px; font-family: monospace;"><%= signing_key %></strong></p>
    <p style="font-size: 13px; color: #666;">You can also enter this key at the signing page to access your document.</p>
  <% end %>
  <p><%= t('please_contact_us_by_replying_to_this_email_if_you_have_any_questions') %></p>
  <p>
  <%= t('thanks') %>,<br><%= @current_account.name %>
  </p>
<% end %>
