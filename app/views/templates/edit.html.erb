<%# Wippli: Skip tour for guest users %>
<% if user_signed_in? && (current_user.created_at > 2.weeks.ago || params[:tour] == 'true') %>
  <% user_config = current_user.user_configs.find_or_initialize_by(key: UserConfig::SHOW_APP_TOUR) %>
  <% @show_tour_start_form = user_config.new_record? && !params.key?(:tour) %>
  <% if user_config.new_record? || user_config.value || params[:tour] == 'true' %>
    <app-tour data-show-tour="<%= params[:tour] == 'true' || user_config.value %>" data-type="builder" data-next-page-path="<%= template_path(@template, params.permit(:tour)) %>" data-i18n="<%= t('app_tour').to_json %>"></app-tour>
    <%= button_to nil, user_configs_path, method: :post, params: { user_config: { key: UserConfig::SHOW_APP_TOUR, value: true } }, class: 'hidden', id: 'start_tour_button' %>
  <% end %>
<% end %>
<%# Wippli: Keep sign-yourself for guests, disable send button %>
<template-builder class="grid" data-template="<%= @template_data %>" data-with-sign-yourself-button="<%= !@template.archived_at? %>" data-with-fields-detection="true" data-with-send-button="<%= user_signed_in? && !@template.archived_at? && can?(:create, @template.submissions.new(account: current_account)) %>" data-locale="<%= I18n.locale %>" data-show-tour-start-form="<%= @show_tour_start_form %>" data-brand-logo-url="<%= @brand_logo_url %>" data-brand-app-name="<%= @brand_app_name %>" data-brand-primary-color="<%= @brand_primary_color %>" data-guest-view="<%= @is_guest_mode %>" data-with-upload-button="<%= !@is_guest_mode %>"></template-builder>
<% if @is_guest_mode %>
<script>
  // Wippli: Intercept post-save navigation for guest users → redirect to signing form
  document.addEventListener('turbo:before-visit', function(event) {
    if (event.detail.url.match(/\/templates\/\d+(\/)?$/)) {
      event.preventDefault();
      var params = new URLSearchParams(window.location.search);
      var slug = params.get('submitter_slug');
      if (slug) {
        window.location.href = '/s/' + slug;
      }
    }
  });
</script>
<% end %>
